{
  "name": "uni-booking-api",
  "version": "1.0.0",
  "description": "API REST Modular CQS - Plataforma de Reservas UNI",
  "main": "dist/main.js",
  "scripts": {
    "start": "node -r ts-node/register -r reflect-metadata src/main.ts",
    "build": "tsc -p tsconfig.app.json",
    "dev": "nodemon --watch src --ext ts,json --exec \"node -r ts-node/register -r reflect-metadata src/main.ts\"",
    "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js",
    "db:migrate": "npm run typeorm -- migration:run -d src/infrastructure/shared/typeorm.datasource.ts",
    "db:migrate:generate": "npm run typeorm -- migration:generate -d src/infrastructure/shared/typeorm.datasource.ts",
    "db:migrate:revert": "npm run typeorm -- migration:revert -d src/infrastructure/shared/typeorm.datasource.ts",
    "db:migrate:undo": "npm run db:migrate:revert",
    "test:unit": "jest --config jest.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.8",
    "@testcontainers/postgresql": "^10.15.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemailer": "^8.0.10",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
