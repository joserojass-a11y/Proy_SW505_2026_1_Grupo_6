# ==========================================
# Configuración del Entorno LOCAL (Fase 0/1)
# ==========================================
NODE_ENV=development
PORT=3000
DEBUG=true
LOG_LEVEL=debug

# ==========================================
# Base de Datos (PostgreSQL 15)
# ==========================================
POSTGRES_USER=uni_admin
POSTGRES_PASSWORD=UniSecurePass2026
POSTGRES_DB=reservas_db
DATABASE_URL=postgresql://uni_admin:UniSecurePass2026@postgres:5432/reservas_db
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# ==========================================
# Caché y Colas (Redis 7)
# ==========================================
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:redis_dev_secret@redis:6379

# ==========================================
# Autenticación JWT (Ajustado a RS256)
# ==========================================
# Se requiere cifrado asimétrico RS256 según diseño, no un secret simple
JWT_PRIVATE_KEY_PATH="./secrets/jwt_private.pem"
JWT_PUBLIC_KEY_PATH="./secrets/jwt_public.pem"
JWT_ACCESS_EXPIRY=900      # 15 minutos en segundos
JWT_REFRESH_EXPIRY=604800  # 7 días en segundos

# ==========================================
# CORS y Frontend
# ==========================================
CORS_ORIGINS=http://localhost